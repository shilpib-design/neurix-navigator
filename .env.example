# Neurix Navigator v0.1 Example Environment File
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY

# Provider Credentials (Optional for production integration runs only)
CONTEXT_DEV_API_KEY=your_context_dev_api_key_here
STRING_API_KEY=your_string_api_key_here
SCRAPFLY_API_KEY=your_scrapfly_api_key_here

# Proxy Provider Credentials
